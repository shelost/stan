{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "books\\..*" }],
      "destination": "/books.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "editions\\..*" }],
      "destination": "/editions.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "phone\\..*" }],
      "destination": "/phone.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "atlas\\..*" }],
      "destination": "/atlas.html"
    }
  ]
}
